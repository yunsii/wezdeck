.sync-target
# worktree-recycle --task brief (also in WT_RECYCLE_CLEAN_GLOBS)
.task-brief.md
# Python bytecode from runtime helpers (e.g. grok-focus-filter)
__pycache__/
*.py[cod]
wezterm-x/local/
wezterm-x/tmux/chord-bindings.generated.conf
wezterm-x/tmux/appearance.generated.conf
wezterm-x/plugins/registry.generated.*
wezterm-x/plugins/.external/
native/picker/bin/
native/picker/picker
native/wezdeck-wsl/bin/
# `go build ./...` run inside the package writes its binary here
native/wezdeck-wsl/wezdeck-wsl
.claude/scheduled_tasks.lock
.claude/settings.local.json

# OpenClaw machine-local (never commit filled secrets or host paths)
openclaw/local/
# Runtime inbound media from Feishu / channel (Gateway workspace)
openclaw/workspace/media/
# OpenClaw agent daily/runtime memory (PII, host paths, task ledger)
openclaw/workspace/memory/
# ACP / agent runtime under linked workspace (sessions, smoke leftovers)
openclaw/workspace/state/
openclaw/workspace/claude/
openclaw/workspace/codex/
# Scratch / handoff files staged by agents (not source of truth)
openclaw/workspace/tmp/
openclaw/workspace/smoke-ok.txt
openclaw/workspace/**/smoke-ok.txt
openclaw/workspace/**/marker.txt
# Vendor ego-browser skill link (absolute /mnt/c/… path from apply-browser-backend)
openclaw/workspace/skills/ego-browser

# habit_report optional NLP venv
scripts/dev/habit_report/.venv/

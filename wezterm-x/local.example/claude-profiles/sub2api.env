# Claude Code → Anthropic-compatible gateway (sub2api / similar).
#
# Install (once, mode 600 — never commit the filled-in copy):
#   mkdir -p ~/.config/claude-profiles
#   cp wezterm-x/local.example/claude-profiles/sub2api.env \
#      ~/.config/claude-profiles/sub2api.env
#   chmod 600 ~/.config/claude-profiles/sub2api.env
#   # edit BASE_URL + token
#
# Loaded ONLY by: agent-launcher.sh claude-sub2api
# Selected by:    MANAGED_AGENT_PROFILE=claude_sub2api  (shared.env)
#
# Do NOT drop this file into ~/.config/shell-env.d/ — that directory is
# auto-sourced for every managed agent, and would force gateway auth onto
# the stock `claude` (team OAuth) profile as well.
#
# Override path: CLAUDE_SUB2API_ENV=/path/to/other.env

ANTHROPIC_BASE_URL='https://your-sub2api-host.example'
# Prefer AUTH_TOKEN for gateways; API_KEY also works if the gateway accepts it.
ANTHROPIC_AUTH_TOKEN='sk-your-token'
# ANTHROPIC_API_KEY='sk-your-token'

# Optional model overrides if the gateway renames Anthropic ids:
# ANTHROPIC_MODEL='claude-sonnet-4-5'
# ANTHROPIC_DEFAULT_SONNET_MODEL='...'
# ANTHROPIC_DEFAULT_OPUS_MODEL='...'

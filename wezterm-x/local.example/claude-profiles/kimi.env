# Claude Code -> Kimi Code (Anthropic-compatible coding endpoint).
# Install as ~/.config/claude-profiles/kimi.env with mode 600.
# Loaded ONLY by agent-launcher.sh claude-kimi / scripts/runtime/cli/claude-kimi.
# Do NOT put this file in ~/.config/shell-env.d/.
#
# Guide: https://www.kimi.com/code/docs/en/third-party-tools/claude-code.html
# Create the key at https://www.kimi.com/code/console (membership required).

ANTHROPIC_BASE_URL='https://api.kimi.ai/coding/'
ANTHROPIC_API_KEY='sk-your-kimi-api-key'

# Default: K3.1 Pro 256K. For 1M context use k3.1-pro[1m] and set
# CLAUDE_CODE_AUTO_COMPACT_WINDOW / CLAUDE_CODE_MAX_CONTEXT_TOKENS to 1048576.
ANTHROPIC_MODEL='k3.1-pro'
ANTHROPIC_DEFAULT_OPUS_MODEL='k3.1-pro'
ANTHROPIC_DEFAULT_SONNET_MODEL='k3.1-pro'
ANTHROPIC_DEFAULT_HAIKU_MODEL='k3.1-pro'
ANTHROPIC_DEFAULT_FABLE_MODEL='k3.1-pro'
CLAUDE_CODE_SUBAGENT_MODEL='k3.1-pro'
CLAUDE_CODE_EFFORT_LEVEL='high'
CLAUDE_CODE_AUTO_COMPACT_WINDOW='262144'
CLAUDE_CODE_MAX_CONTEXT_TOKENS='262144'
# Kimi does not implement Anthropic server-side auto-mode classifier pass-through
# (safeguards / safeguard_results). Keep client-side classifier; hide the notice.
# https://code.claude.com/docs/en/auto-mode-classifier-billing
CLAUDE_CODE_AUTO_MODE_SERVER='0'

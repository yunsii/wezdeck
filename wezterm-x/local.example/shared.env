# Shared scalar config for both Lua and shell runtime code.
# Copy this file to wezterm-x/local/shared.env and fill in private values there.
#
# Scope: this file is for repo-machine config consumed by *both* Lua and
# shell — values that must be synced to the Windows runtime alongside the
# rest of wezterm-x/. For user-level secrets (CNB tokens, third-party API
# keys, etc.) prefer `~/.config/shell-env.d/<name>.env` instead; that
# directory is auto-discovered by `~/.zshrc` and the runtime loader
# together, so adding a secret needs no rc-file edits and no loader
# edits. Full convention: docs/setup.md#env-loading-model.

WAKATIME_API_KEY='your-wakatime-api-key'

# Machine-local default agent profile shared by WezTerm and worktree-task.
# Supported tracked profiles: claude | claude_sub2api | codex
#   claude         — OAuth / team subscription (default)
#   claude_sub2api — gateway via ~/.config/claude-profiles/sub2api.env
#   codex          — Codex CLI
# Temporary switch: set claude_sub2api here, open/refresh agent panes;
# flip back to claude when the team limit resets. Process-scoped — see
# docs/setup.md#claude-auth-profiles.
MANAGED_AGENT_PROFILE='claude'

# Window appearance preset. 'opaque' (default) = original solid look;
# 'frosted' = translucent window + Windows 11 acrylic blur + a tab bar that
# dissolves into the frost. Read by both the WezTerm side
# (wezterm-x/lua/config/appearance-presets.lua) and the tmux side
# (scripts/runtime/render-tmux-appearance.sh). Frosted needs Windows 11
# (22621+); tune it via a local/constants.lua `appearance` override.
# Full model: docs/appearance-presets.md.
WEZTERM_APPEARANCE_PRESET='opaque'

# Host volume the disk guard watches, as a WSL-side mount point. Leave empty
# to follow wherever ext4.vhdx actually lives, which is the right answer
# unless you deliberately want to watch a different disk. Set it when the
# distro's vhdx and the volume you care about are not the same thing.
WEZTERM_DISK_VOLUME=''

# Host space withheld from WSL, in GiB. The guard subtracts this from the
# reported headroom, so the badge counts down to "WSL is out of budget" while
# the volume still has room left — rather than to "the volume is dry", which
# breaks more than the distro. Set 0 on a volume nothing else uses.
# Thresholds are percentages of the remaining budget and default to
# warn <10% / crit <5%; override with WEZTERM_DISK_WARN_PCT /
# WEZTERM_DISK_CRIT_PCT if needed. Full model: docs/diagnostics.md.
WEZTERM_DISK_RESERVE_GB='5'

# Optional VS Code profile name used by Alt+v.
WEZTERM_VSCODE_PROFILE='ai-dev'

# Optional safety cap for Alt+v in hybrid-wsl. When the requested folder is
# not already open and this many visible VS Code windows already exist, Alt+v
# reuses the least recently used helper-tracked VS Code window instead of
# launching another one. Leave empty or unset for no cap.
WEZTERM_VSCODE_MAX_WINDOWS=''

# WezDeck user-level env vars. Mode 600.
#
# Install (once):
#   mkdir -p ~/.config/shell-env.d
#   cp wezterm-x/local.example/shell-env.d/wezdeck-env.env ~/.config/shell-env.d/
#   chmod 600 ~/.config/shell-env.d/wezdeck-env.env
#
# Loaded by scripts/runtime/runtime-env-lib.sh::runtime_env_load_managed
# (managed agents) and, once ~/.zshrc contains
# wezterm-x/local.example/zshrc-shell-env.zsh, by interactive zsh.
# Then whatever lives here is visible in both.
#
# Scope: pure env vars. Aliases and zsh functions live in the sibling
# wezdeck-fn.env (functions cannot survive a subprocess boundary, so
# the runtime loader treats that file as a no-op).
#
# Lex-order pairing with wezdeck-fn.env: `-env.` < `-fn.`, so this
# file loads first and `wezdeck-fn.env` can reference values set
# below at definition time, not just at call time.
#
# Retired names wezterm-env.env / wezterm-fn.env are not loaded. The
# runtime loader warns and skips them. See docs/setup.md#env-loading-model.

# External capability source anchor. Edit if you cloned the repo somewhere
# other than ~/github/wezterm-config. Skills, profiles, shell wrappers, and
# agent-tools paths all derive from this absolute root.
export WEZDECK_REPO="$HOME/github/wezterm-config"

# User-facing CLI commands live under scripts/runtime/cli/ (no .sh
# suffix). Prepending the dir to PATH lets you add a new command with
# a single file drop — no rc-file edits, no PATH edits, no symlinks.
export PATH="$WEZDECK_REPO/scripts/runtime/cli:$PATH"

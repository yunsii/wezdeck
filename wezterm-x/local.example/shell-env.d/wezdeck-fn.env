# WezDeck user-level shell functions / aliases. Mode 600.
#
# Install (once):
#   mkdir -p ~/.config/shell-env.d
#   cp wezterm-x/local.example/shell-env.d/wezdeck-fn.env ~/.config/shell-env.d/
#   chmod 600 ~/.config/shell-env.d/wezdeck-fn.env
#
# Scope: things that must run in the parent shell — `cd`-ing
# helpers, completion hooks, prompt tweaks, aliases. Plain
# subprocess-runnable tooling belongs in scripts/runtime/cli/ instead
# (see sibling wezdeck-env.env).
#
# Loaded by interactive zsh after the zshrc-shell-env.zsh snippet
# (functions persist for that session) and by the runtime env loader
# (functions define and immediately vanish with the subprocess —
# harmless, just useless there).
#
# Convention: prefix function and alias names with `wezdeck-` so they
# cannot shadow a real binary that a subprocess might rely on.

# Example: uncomment to jump to the repo from anywhere.
#
# wezdeck() {
#   cd "${WEZDECK_REPO:?wezdeck-env.env not loaded}/${1:-}"
# }

# WezDeck browser-agent backend. Mode 600.
#
# Install / switch (preferred — also writes OpenClaw MCP/skill links):
#   apply-browser-backend --set ego
#   apply-browser-backend --set cdp
#
# Or copy this template and edit by hand, then run apply-browser-backend
# without --set so OpenClaw catches up:
#   cp wezterm-x/local.example/shell-env.d/wezdeck-browser-agent.env \
#      ~/.config/shell-env.d/
#   chmod 600 ~/.config/shell-env.d/wezdeck-browser-agent.env
#
# Values: ego | cdp  (no auto)
# Session override: export WEZDECK_BROWSER_BACKEND=ego|cdp
#
# Docs: docs/browser-debug.md (browser backends)

export WEZDECK_BROWSER_BACKEND=ego

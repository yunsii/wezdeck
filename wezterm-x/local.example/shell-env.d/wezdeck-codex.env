# Interactive zsh in tmux routes Codex through the WezDeck launcher.
if [ -n "${ZSH_VERSION:-}" ] && [[ $- == *i* ]] && [ -n "${TMUX:-}" ]; then
  codex() {
    local launcher="${WEZDECK_REPO:-}/scripts/runtime/agent-launcher.sh"
    if [ -n "${WEZDECK_REPO:-}" ] && [ -x "$launcher" ]; then
      bash "$launcher" codex --interactive "$@"
    else
      command codex "$@"
    fi
  }
fi

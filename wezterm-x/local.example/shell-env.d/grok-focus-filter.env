# Grok Build focus-filter launch wrap. Mode 600.
#
# Install (once):
#   mkdir -p ~/.config/shell-env.d
#   cp wezterm-x/local.example/shell-env.d/grok-focus-filter.env ~/.config/shell-env.d/
#   chmod 600 ~/.config/shell-env.d/grok-focus-filter.env
#   # reload zsh or open a new shell
#
# Why: `grok update` overwrites ~/.grok/bin/grok with a bare ELF / downloads
# symlink. zshrc prepends that dir, so interactive `grok` bypasses the PATH
# wrapper and flashes under tmux until --install. This function always calls
# the repo wrapper by absolute path (same idea as agent-launcher for managed
# panes). The wrapper's quiet ensure then re-seats PATH, promotes grok.real,
# and re-applies the GrokDay bg_base cream/Reset patch.
#
# Intentional name shadow: `grok` must win over PATH. Use `command grok` only
# when you deliberately want the raw binary (will flash under tmux).
#
# Requires WEZDECK_REPO from sibling wezterm-env.env (loads first by lex order).

grok() {
  local wrap="${WEZDECK_REPO:?WEZDECK_REPO unset — load wezterm-env.env first}/scripts/runtime/grok-with-focus-filter.sh"
  if [[ ! -x "$wrap" ]]; then
    print -u2 "grok: missing focus-filter wrapper at $wrap"
    return 127
  fi
  "$wrap" "$@"
}

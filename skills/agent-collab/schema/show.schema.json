{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-api/show.schema.json",
  "title": "ticket api show (v1)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "v",
        "ok",
        "command",
        "ticket",
        "reference",
        "sections",
        "children",
        "runs"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "show"
        },
        "ticket": {
          "type": "object",
          "required": [
            "id",
            "status",
            "runs",
            "running"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "from": {
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "type": [
                "string",
                "null"
              ]
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "handler": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "repo": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "cwd": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "session": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "via": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "updated_at": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "phase": {
              "type": [
                "string",
                "null"
              ]
            },
            "owner": {
              "type": [
                "string",
                "null"
              ]
            },
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "runs": {
              "type": "integer"
            },
            "running": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "last_milestone": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "ts": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            },
            "last_run": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "run",
                    "backend",
                    "tokens",
                    "session",
                    "exit"
                  ],
                  "properties": {
                    "run": {
                      "type": "string"
                    },
                    "phase": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "role": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "backend": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "wall_ms": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "turns": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "tokens": {
                      "type": "object",
                      "required": [
                        "input",
                        "cache_read",
                        "cache_write",
                        "output"
                      ],
                      "properties": {
                        "input": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cache_read": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "cache_write": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "output": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      }
                    },
                    "cache_hit_rate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "cost_usd": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "tool_calls": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "rss_peak_mb": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "exit": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "session": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reuse": {
                          "enum": [
                            "fresh",
                            "resume",
                            "fork",
                            null
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "from": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "reference": {
          "type": "string",
          "description": "text block for another agent (web 复制引用); reference.py"
        },
        "meta": {
          "type": "object"
        },
        "sessions": {
          "type": "object"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "text"
            ]
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "run",
              "backend",
              "tokens",
              "session",
              "exit"
            ],
            "properties": {
              "run": {
                "type": "string"
              },
              "phase": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "backend": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wall_ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "turns": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tokens": {
                "type": "object",
                "required": [
                  "input",
                  "cache_read",
                  "cache_write",
                  "output"
                ],
                "properties": {
                  "input": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cache_read": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "cache_write": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "output": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "cache_hit_rate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cost_usd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tool_calls": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rss_peak_mb": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "exit": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "session": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "reuse": {
                    "enum": [
                      "fresh",
                      "resume",
                      "fork",
                      null
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "from": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "running": {
          "type": "array"
        },
        "children_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "gate": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "gate": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "detail": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "ts": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              },
              "last_milestone": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "ts": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "collab": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "scheduler": {
              "type": "object",
              "required": [
                "alive"
              ],
              "properties": {
                "alive": {
                  "type": "boolean"
                },
                "pid": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "questions": {
          "description": "Structured questions while status=waiting_initiator (challenge / need_input); null otherwise.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "questions"
              ],
              "properties": {
                "asked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "research | challenge"
                },
                "questions": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": [
                      "question",
                      "options",
                      "multi_select"
                    ],
                    "properties": {
                      "header": {
                        "type": "string"
                      },
                      "question": {
                        "type": "string"
                      },
                      "multi_select": {
                        "type": "boolean"
                      },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "required": [
                            "label"
                          ],
                          "properties": {
                            "label": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "proposals": {
          "description": "Fan-out splits awaiting the user's confirmation (lib/split.py): origin draft (plan agent) or split (a running child). Empty when none.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "origin",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "origin": {
                "enum": [
                  "draft",
                  "split"
                ]
              },
              "by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "warnings": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "key",
                    "to",
                    "title"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    },
                    "assumed": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "depends_on": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "effect": {
                      "type": "string"
                    }
                  }
                }
              },
              "contract": {
                "type": "string",
                "description": "draft only: the parent contract under review (≤8000 chars)"
              },
              "summary": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "draft only: plain words for the approver",
                "properties": {
                  "problem": {
                    "type": "string"
                  },
                  "approach": {
                    "type": "string"
                  }
                }
              },
              "status_check": {
                "type": [
                  "array",
                  "null"
                ],
                "description": "draft only: each goal item vs the target's default branch",
                "items": {
                  "type": "object",
                  "required": [
                    "item",
                    "status",
                    "evidence"
                  ],
                  "properties": {
                    "item": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "missing",
                        "partial",
                        "done"
                      ]
                    },
                    "evidence": {
                      "type": "string"
                    },
                    "reuse": {
                      "type": "string"
                    }
                  }
                }
              },
              "risks": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "outcome": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "computed by split.py (not the model): what confirming starts",
                "properties": {
                  "workers": {
                    "type": "integer"
                  },
                  "max_parallel": {
                    "type": "integer"
                  },
                  "stages": {
                    "type": "integer"
                  },
                  "repos": {
                    "type": "object"
                  },
                  "backend": {
                    "type": "string"
                  },
                  "mem_peak_mb": {
                    "type": "integer"
                  },
                  "est_mb_each": {
                    "type": "integer"
                  },
                  "est_source": {
                    "type": "string"
                  },
                  "minutes_each": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "samples": {
                    "type": "object"
                  },
                  "delivery": {
                    "type": "object"
                  },
                  "pushes": {
                    "type": "boolean"
                  },
                  "estimated_at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "ok",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "bad_request",
                "not_found",
                "unknown_command",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-api/error.schema.json",
  "type": "object",
  "required": [
    "v",
    "ok",
    "error"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "ok": {
      "const": false
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "bad_request",
            "not_found",
            "unknown_command",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}

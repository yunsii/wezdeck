{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delegate-api/metrics.schema.json",
  "title": "delegate api metrics (v1)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "v",
        "ok",
        "command",
        "window",
        "runs",
        "sessions",
        "tokens",
        "cache_hit_rate",
        "by_backend",
        "by_reuse",
        "reuse_reasons"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "command": {
          "const": "metrics"
        },
        "window": {
          "type": "string"
        },
        "runs": {
          "type": "integer"
        },
        "failed_runs": {
          "type": "integer"
        },
        "sessions": {
          "type": "integer"
        },
        "turns": {
          "type": "integer"
        },
        "tokens": {
          "type": "object",
          "required": [
            "input",
            "cache_read",
            "cache_write",
            "output"
          ],
          "properties": {
            "input": {
              "type": [
                "number",
                "null"
              ]
            },
            "cache_read": {
              "type": [
                "number",
                "null"
              ]
            },
            "cache_write": {
              "type": [
                "number",
                "null"
              ]
            },
            "output": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "cache_hit_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "wall_ms": {
          "type": "object"
        },
        "rss_peak_mb": {
          "type": "object"
        },
        "by_backend": {
          "type": "object"
        },
        "by_reuse": {
          "type": "object"
        },
        "reuse_reasons": {
          "type": "object"
        },
        "by_repo": {
          "type": "object"
        },
        "by_trigger": {
          "type": "object"
        },
        "prompt_est_tokens_by_phase": {
          "type": "object"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "v",
        "ok",
        "error"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "bad_request",
                "not_found",
                "unknown_command",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}

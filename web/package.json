{
  "name": "web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "i18n:extract": "lingui extract",
    "i18n:check": "lingui check sync && lingui check missing --mode catalog",
    "typecheck": "tsc --noEmit",
    "mock-runtime": "node scripts/mock-runtime.mjs",
    "capture:console-preview": "node scripts/capture-console-preview.mjs",
    "test:cdp": "vitest run --config vitest.cdp.config.ts",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lingui/core": "^6.8.0",
    "@lingui/react": "^6.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.48.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-lingui": "^0.16.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-babel-macros": "^1.0.6",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

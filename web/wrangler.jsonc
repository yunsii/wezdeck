{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wezdeck",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // yuns.love DNS lives in the same Cloudflare account (same as forge);
  // keep workers.dev disabled so the custom domain is the single public entry.
  "routes": [{ "pattern": "wezdeck.yuns.love", "custom_domain": true }],
  "workers_dev": false,
  // HostRelay lives in its own standalone Worker (`wezdeck-relay-do`,
  // wrangler.relay.jsonc) so routine frontend deploys never recycle the DO
  // or drop active WebSocket/WebRTC sessions. docs/remote-access.md
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RELAY",
        "class_name": "HostRelay",
        "script_name": "wezdeck-relay-do",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostRelay"] },
    { "tag": "v2", "deleted_classes": ["HostRelay"] },
  ],
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wezdeck",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // yuns.love DNS lives in the same Cloudflare account (same as forge);
  // keep workers.dev disabled so the custom domain is the single public entry.
  "routes": [{ "pattern": "wezdeck.yuns.love", "custom_domain": true }],
  "workers_dev": false,
  // HostRelay lives in its own standalone Worker (`wezdeck-relay-do`,
  // wrangler.relay.jsonc) under class `HostRelayDO` so routine frontend deploys
  // never recycle the DO and v2 `deleted_classes: ["HostRelay"]` does not
  // collide with the cross-script binding (Cloudflare error 10061).
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_RELAY",
        "class_name": "HostRelayDO",
        "script_name": "wezdeck-relay-do",
      },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostRelay"] },
    { "tag": "v2", "deleted_classes": ["HostRelay"] },
  ],
}

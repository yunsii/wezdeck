{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh running"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh done"
          },
          {
            "type": "command",
            "command": "bash __WEZDECK_REPO__/scripts/runtime/tmux-status-refresh.sh --force --refresh-client >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh resolved"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh resolved"
          },
          {
            "type": "command",
            "command": "bash __WEZDECK_REPO__/scripts/runtime/tmux-status-refresh.sh --force --refresh-client >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "__WEZDECK_REPO__/scripts/claude-hooks/emit-agent-status.sh pane-evict"
          }
        ]
      }
    ]
  }
}

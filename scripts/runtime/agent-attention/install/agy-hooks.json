{
  "wezdeck-attention": {
    "SessionStart": [
      { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh pane-evict" }
    ],
    "PreInvocation": [
      { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh running" }
    ],
    "PreToolUse": [
      { "matcher": "ask_question", "hooks": [
        { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh ask-waiting" }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "ask_question", "hooks": [
        { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh ask-resolved" }
      ] },
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh resolved" }
      ] }
    ],
    "Stop": [
      { "type": "command", "command": "__WEZDECK_REPO__/scripts/runtime/agent-attention/adapters/agy.sh done" }
    ]
  }
}

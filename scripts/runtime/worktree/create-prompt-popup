#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: create-prompt-popup [cwd]

Open the new-workstation prompt (create-prompt) inside a tmux display-popup.
USAGE
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  dev|task|hotfix)
    # removed with the lifecycles (2026-11-25): a stale chord binding
    printf 'create-prompt-popup: the %s argument is removed; re-render the tmux bindings (sync-runtime)\n' "$1" >&2
    exit 64
    ;;
esac
if (($# > 1)); then
  usage >&2
  exit 64
fi

cwd="${1:-$PWD}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
prompt="$script_dir/create-prompt"

if [[ ! -x "$prompt" ]]; then
  printf 'create-prompt-popup: prompt not executable: %s\n' "$prompt" >&2
  exit 1
fi

if [[ ! -d "$cwd" ]]; then
  cwd="$PWD"
fi

printf -v popup_command 'exec %q' "$prompt"
exec bash "$script_dir/../tmux-display-popup.sh" -E -d "$cwd" -w "88%" -h "60%" -T "new workstation" "$popup_command"

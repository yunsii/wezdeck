#!/usr/bin/env bash
# open-task-window — create a workstation: a linked worktree for one
# direction (ux, ci, i18n …) off the latest origin/HEAD, directory <name>,
# branch dev/<name>, with a one-line purpose in the git branch description
# (lib/workstation.sh). A taken name is bumped to <name>-2, -3 … on both the
# directory and the branch. Reopening an existing workstation belongs to
# `Alt+g` / `Alt+Shift+g`; a new round on one is `worktree-task recycle`.
#
# The agent launches under the `<base>-resume` profile (auto-continue the
# cwd's last conversation, fall back to a fresh agent on a new cwd). `<base>`
# comes from workspace-agent-map.tsv for the current repo (per-item launcher
# in workspaces.lua), else MANAGED_AGENT_PROFILE (claude / codex / …).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEZTERM_CONFIG_REPO_DEFAULT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
WORKTREE_TASK_CLI="$SCRIPT_DIR/worktree-task"
RUNTIME_LIB_DIR="$WEZTERM_CONFIG_REPO_DEFAULT/scripts/runtime"

# shellcheck disable=SC1091
source "$RUNTIME_LIB_DIR/runtime-log-lib.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/helpers.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/git.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/config.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/core.sh"

export WEZTERM_RUNTIME_LOG_SOURCE="worktree-task.open-window"

usage() {
  cat <<'USAGE'
usage: open-task-window [--description TEXT] [--no-attach] [--] <name>

Create a workstation for the direction <name> (letters or digits; a dev- or
dev/ prefix typed out of habit is dropped): directory <name>, branch
dev/<name>, from the latest origin/HEAD.

  --description TEXT  one-line purpose (git branch description, ≤ 120 chars)
  --no-attach         open the window without switching / attaching to it
USAGE
}

die() {
  printf 'open-task-window: %s\n' "$1" >&2
  exit 1
}

description=""
raw=""
no_attach=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --description)
      [[ $# -ge 2 ]] || die "--description requires a value"
      description="$2"
      shift 2
      ;;
    --description=*)
      description="${1#--description=}"
      shift
      ;;
    --type|--type=*)
      # removed with the dev / task / hotfix lifecycles (2026-11-25)
      die "--type is removed: every worktree is a workstation; drop --type (pass --description for its purpose)"
      ;;
    --no-attach)
      # prepare the window without switching / attaching (callers with no
      # terminal: the phone's new session, native/wezdeck-wsl session_new.go)
      no_attach=1
      shift
      ;;
    --)
      shift
      [[ $# -eq 1 && -n "${1:-}" ]] || { usage >&2; exit 1; }
      raw="$1"
      shift
      ;;
    -*)
      die "unknown flag: $1"
      ;;
    *)
      [[ -z "$raw" ]] || die "expected exactly one positional <name>, got more"
      raw="$1"
      shift
      ;;
  esac
done

[[ -n "$raw" ]] || { usage >&2; exit 1; }

wt_core_resolve_repo_context "$PWD"
wt_config_load
wt_core_resolve_policy_paths
if ! wt_workstation_plan "$raw"; then
  runtime_log_warn worktree "workstation name refused" "raw=$raw" "error=$WT_PLAN_ERROR"
  die "$WT_PLAN_ERROR"
fi
task_slug="$WT_PLAN_SLUG"
branch_name="$WT_PLAN_BRANCH"
# the name is an existing workstation's: open a parallel slot of its
# direction, inheriting the purpose unless another one was given
if [[ -n "$WT_PLAN_PARALLEL_OF" && -z "$description" ]]; then
  description="$WT_PLAN_PARALLEL_DESCRIPTION"
fi

# Profile selection. Prefer per-repo launcher from workspace-agent-map.tsv
# (derived from workspaces.lua), then MANAGED_AGENT_PROFILE / shared.env.
# Always launch the resume variant: cwd auto-resume; with no prior
# conversation for the cwd, the resume command falls back to a fresh agent.
# shellcheck disable=SC1091
source "$RUNTIME_LIB_DIR/worktree/lib/resume-command.sh"
base_profile="$(resume_command_active_profile "${WEZTERM_CONFIG_REPO:-$WEZTERM_CONFIG_REPO_DEFAULT}" "$PWD")"
base_profile="${base_profile:-claude}"
selected_profile="${base_profile}-resume"
quick_create_provider="${WT_QUICK_CREATE_PROVIDER:-tmux-agent}"
quick_create_provider_mode="${WT_QUICK_CREATE_PROVIDER_MODE:-auto}"

[[ -x "$WORKTREE_TASK_CLI" ]] || die "worktree-task CLI not found or not executable: $WORKTREE_TASK_CLI"

launch_env=(env)
if [[ -z "${WEZTERM_CONFIG_REPO:-}" ]]; then
  launch_env+=("WEZTERM_CONFIG_REPO=$WEZTERM_CONFIG_REPO_DEFAULT")
fi
if [[ -n "$selected_profile" ]]; then
  launch_env+=("MANAGED_AGENT_PROFILE=$selected_profile")
fi
# `env` with no extra args is a noop wrapper; the shape stays consistent
# whether we set anything or not.

runtime_log_info worktree "dispatching to worktree-task launch" \
  "raw=$raw" "task_slug=$task_slug" "branch=$branch_name" "bumped=$WT_PLAN_BUMPED" \
  "parallel_of=$WT_PLAN_PARALLEL_OF" \
  "described=$([[ -n "$description" ]] && echo 1 || echo 0)" "profile=${selected_profile:-<inherit>}"

# Immediate feedback so the user sees the chord registered before any
# slow git/fetch work starts. Each downstream stage will replace this
# message in the same status-line slot. No-op outside tmux.
if [[ -n "${TMUX:-}" ]]; then
  tmux_session="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
  if [[ -n "$tmux_session" ]]; then
    tmux set-option -q -t "$tmux_session" '@tmux_status_override_line_2' \
      "[worktree-task] preparing $task_slug…" 2>/dev/null || true
    tmux refresh-client -S 2>/dev/null || true
  fi
fi

launch_args=(
  launch
  --title "$WT_PLAN_NAME"
  --task-slug "$task_slug"
  --branch "$branch_name"
  --provider "$quick_create_provider"
  --provider-mode "$quick_create_provider_mode"
)
if [[ -n "${WT_QUICK_CREATE_BASE_REF:-}" ]]; then
  launch_args+=(--base-ref "$WT_QUICK_CREATE_BASE_REF")
fi
if [[ -n "$description" ]]; then
  launch_args+=(--description "$description")
fi
if [[ -n "$WT_PLAN_PARALLEL_OF" ]]; then
  launch_args+=(--direction "$WT_PLAN_PARALLEL_OF")
fi
if (( no_attach )); then
  launch_args+=(--no-attach)
fi

exec "${launch_env[@]}" "$WORKTREE_TASK_CLI" "${launch_args[@]}"

#!/usr/bin/env bash
# create-prompt — the tmux popup behind Ctrl+k g d: name a new workstation
# (the direction: ux, ci, i18n …) and give it a one-line purpose, with a live
# preview of the directory and branch it becomes (lib/workstation.sh, the
# same plan open-task-window runs). Enter on the name moves to the
# description, Enter on the description creates, Tab switches, Esc cancels.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEZTERM_CONFIG_REPO_DEFAULT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
RUNTIME_LIB_DIR="$WEZTERM_CONFIG_REPO_DEFAULT/scripts/runtime"

# shellcheck disable=SC1091
source "$RUNTIME_LIB_DIR/runtime-log-lib.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/helpers.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/git.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/config.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/core.sh"

export WEZTERM_RUNTIME_LOG_SOURCE="worktree-task.create-prompt"

usage() {
  cat <<'USAGE'
usage:
  create-prompt                 interactive (inside a tmux popup)
  create-prompt --preview NAME  print the plan for NAME (key=value lines)

Name a new workstation and its purpose; Enter creates it through
open-task-window.
USAGE
}

die() {
  printf 'create-prompt: %s\n' "$1" >&2
  exit 1
}

preview_name=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --preview)
      [[ $# -ge 2 ]] || die "--preview requires a value"
      preview_name="$2"
      shift 2
      ;;
    --type|--type=*)
      die "--type is removed: every worktree is a workstation (run create-prompt without it)"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

wt_core_resolve_repo_context "$PWD"
wt_config_load
wt_core_resolve_policy_paths

compute_preview() {
  local raw="${1:-}" status
  if wt_workstation_plan "$raw"; then
    status="new"
    [[ "$WT_PLAN_BUMPED" == 1 ]] && status="bumped"
  else
    status="error"
  fi
  printf 'raw=%s\n' "$raw"
  printf 'name=%s\n' "$WT_PLAN_NAME"
  printf 'slug=%s\n' "$WT_PLAN_SLUG"
  printf 'worktree=%s\n' "${WT_PLAN_SLUG:+$WT_POLICY_WORKTREE_DIR_ABS/$WT_PLAN_SLUG}"
  printf 'branch=%s\n' "$WT_PLAN_BRANCH"
  printf 'taken=%s\n' "$WT_PLAN_TAKEN"
  printf 'parallel_of=%s\n' "$WT_PLAN_PARALLEL_OF"
  printf 'status=%s\n' "$status"
  printf 'error=%s\n' "$WT_PLAN_ERROR"
}

if [[ -n "$preview_name" ]]; then
  runtime_log_info worktree "create prompt preview" "cwd=$PWD" "preview=$preview_name"
  compute_preview "$preview_name"
  exit 0
fi

render() {
  local name="$1" description="$2" field="$3"
  local rows cols line
  IFS=' ' read -r rows cols < <(stty size 2>/dev/null || printf '22 96')
  wt_workstation_plan "$name" || true

  printf '\033[H\033[2J'
  printf '\033[1mnew workstation\033[0m  \033[2mone direction, latest %s, reset each round with recycle\033[0m\n\n' "origin/HEAD"
  if [[ "$field" == name ]]; then
    printf '\033[1m> name:        %s\033[0m\n' "$name"
    printf '  description: %s\n' "$description"
  else
    printf '  name:        %s\n' "$name"
    printf '\033[1m> description: %s\033[0m\n' "$description"
  fi
  printf '\n'
  if [[ -z "$WT_PLAN_NAME" ]]; then
    printf '\033[2ma short direction name (ux, ci, i18n); the description says what it is for\033[0m\n'
  elif [[ -n "$WT_PLAN_ERROR" ]]; then
    printf '\033[31m%s\033[0m\n' "$WT_PLAN_ERROR"
  else
    printf 'worktree: %s\n' "$WT_POLICY_WORKTREE_DIR_ABS/$WT_PLAN_SLUG"
    printf 'branch:   %s\n' "$WT_PLAN_BRANCH"
    if [[ -n "$WT_PLAN_PARALLEL_OF" ]]; then
      local slots
      slots="$(wt_workstation_slots "$WT_MAIN_WORKTREE_ROOT" "$WT_PLAN_PARALLEL_OF" | grep -c . || true)"
      printf '\033[36m%s already has %s workstation(s): Enter opens %s in parallel (Alt+g opens an existing one)\033[0m\n' \
        "$WT_PLAN_PARALLEL_OF" "$slots" "$WT_PLAN_SLUG"
      [[ -n "$description" || -z "$WT_PLAN_PARALLEL_DESCRIPTION" ]] \
        || printf '\033[2mpurpose (inherited unless you type one): %s\033[0m\n' "$WT_PLAN_PARALLEL_DESCRIPTION"
    elif [[ "$WT_PLAN_BUMPED" == 1 && -n "$WT_PLAN_TAKEN" ]]; then
      printf '\033[33m%s is taken by %s — Alt+g opens it; this creates %s\033[0m\n' \
        "$WT_PLAN_NAME" "${WT_PLAN_TAKEN##*/}" "$WT_PLAN_SLUG"
    elif [[ "$WT_PLAN_BUMPED" == 1 ]]; then
      printf '\033[33mbranch %s%s exists: this creates %s\033[0m\n' \
        "$WT_POLICY_BRANCH_PREFIX" "${WT_PLAN_SLUG%-*}" "$WT_PLAN_SLUG"
    fi
  fi
  printf '\n'
  line="Enter next/create | Tab switch field | Backspace delete | Ctrl+U clear | Esc cancel"
  printf '\033[2m%-*.*s\033[0m' "$cols" "$cols" "$line"
}

read_key() {
  local key extra
  REPLY=""
  if ! IFS= read -rsn1 key; then
    runtime_log_warn worktree "create prompt input ended" "cwd=$PWD"
    return 1
  fi
  if [[ "$key" == $'\033' ]]; then
    if IFS= read -rsn15 -t 0.001 extra; then
      key+="$extra"
    fi
  fi
  REPLY="$key"
}

create() {
  local name="$1" description="$2" rc
  printf '\033[0m\033[?25h\033[H\033[2J'
  runtime_log_info worktree "create prompt submitted" "cwd=$PWD" "name=$name" \
    "described=$([[ -n "$description" ]] && echo 1 || echo 0)"
  set +e
  bash "$SCRIPT_DIR/open-task-window" --description "$description" -- "$name"
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    # keep the error on screen: the popup would close with it otherwise
    printf '\ncreating the workstation failed (rc=%d). Press any key to close, or wait 30 seconds.\n' "$rc" >&2
    IFS= read -rsn1 -t 30 _ || true
  fi
  exit "$rc"
}

runtime_log_info worktree "create prompt started" "cwd=$PWD"
name=""
description=""
field="name"
printf '\033[?25l'
trap 'printf "\033[0m\033[?25h"' EXIT

while true; do
  render "$name" "$description" "$field"
  if ! read_key; then
    printf '\n\ninput unavailable; prompt cannot read from popup tty.\n'
    printf 'cwd: %s\n' "$PWD"
    printf 'Press any key to close, or wait 5 seconds.\n'
    IFS= read -rsn1 -t 5 _ || true
    exit 1
  fi
  key="$REPLY"
  case "$key" in
    ""|$'\r'|$'\n')
      if [[ "$field" == name ]]; then
        wt_workstation_plan "$name" && field="description"
      elif wt_workstation_plan "$name"; then
        create "$name" "$description"
      else
        field="name"
      fi
      ;;
    $'\t')
      if [[ "$field" == name ]]; then field="description"; else field="name"; fi
      ;;
    $'\033'|$'\003')
      exit 0
      ;;
    $'\177'|$'\010')
      if [[ "$field" == name ]]; then
        name="${name%?}"
      else
        description="${description%?}"
      fi
      ;;
    $'\025')
      if [[ "$field" == name ]]; then name=""; else description=""; fi
      ;;
    *)
      if [[ "$key" =~ [[:print:]] ]]; then
        if [[ "$field" == name ]]; then name+="$key"; else description+="$key"; fi
      fi
      ;;
  esac
done

#!/usr/bin/env bash
# Purge browser history + omnibox suggestions for given hostnames.
#
#   browser-history-purge --target chrome|edge|brave|chromium|chrome-debug|ego \
#     (--domains a,b | --domains-file F)... [--apply [--stop [--no-restart]]]
#   browser-history-purge --target … --recycle-backups [--backup-keep N]
#
# --target is the browser profile to clean, NOT WEZDECK_BROWSER_BACKEND:
#   chrome|edge|brave  everyday Windows Chromium browser (Default profile under
#           %LOCALAPPDATA%; paths in browser-history/browsers.tsv; --profile
#           overrides). WezDeck's debug Chrome (own --user-data-dir) does not
#           block everyday --apply. --stop (with --apply) closes only processes
#           of that browser holding the target profile (graceful close of the
#           browser process, 20s, then taskkill /F), purges, and reopens with
#           --restore-last-session unless --no-restart. It closes the user's
#           browser: get explicit user confirmation first.
#   chromium  every installed chrome/edge/brave that has Default/History;
#           skips missing installs. One browser stop-failed → skip that
#           browser and continue; overall exit non-zero if any leg failed.
#           --profile is not allowed with chromium.
#   chrome-debug  WezDeck debug Chrome user_data_dir from
#           wezterm-x/local/constants.lua (chrome_debug_browser.user_data_dir),
#           override with BROWSER_HISTORY_PURGE_CHROME_DEBUG_USER_DATA. Prefer
#           --stop --no-restart (helper auto-starts headless again).
#   ego     ego (lite) via chrome://history UI automation (ego-browser nodejs);
#           one process per domain, each time-limited, read back after delete.
#
# Backups (chromium-family --apply): copy History/Shortcuts/Top Sites into
#   <profile>/.history-purge-bak/<stamp>/ before delete. On verify success,
#   recycle so only the newest --backup-keep stamps remain (default 1; 0=none).
#   Failed verify keeps every stamp for rollback. Legacy sidecar *.bak-<stamp>
#   files are included in recycle. --recycle-backups runs retention only.
#
# Default is dry-run; --apply deletes. Hostnames match exactly. No built-in
# domain list: keep yours in wezterm-x/local/ (template:
# wezterm-x/local.example/browser-history-purge.domains).
#
# Exit: 0 ok, 1 verify/delete failed, 2 usage, 3 refused (browser holds profile,
# or --stop could not close it; nothing changed for that browser).
# Docs: docs/browser-debug.md#history-purge-by-domain
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
IMPL_DIR="$RUNTIME_DIR/browser-history"
BROWSERS_TSV="${BROWSER_HISTORY_PURGE_BROWSERS_TSV:-$IMPL_DIR/browsers.tsv}"

# shellcheck disable=SC1091
source "$RUNTIME_DIR/runtime-log-lib.sh" 2>/dev/null || true
WEZTERM_RUNTIME_LOG_SOURCE="${WEZTERM_RUNTIME_LOG_SOURCE:-browser-history-purge}"

usage() {
  sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

Options:
  --target chrome|edge|brave|chromium|chrome-debug|ego   required
  --domains a.com,b.com   repeatable (not needed with --recycle-backups)
  --domains-file PATH     one hostname per line, # comments; repeatable
  --apply                 actually delete (default: dry-run)
  --profile DIR           single chromium / chrome-debug: profile with History
  --stop                  chromium-family + --apply: close that browser first
  --no-restart            with --stop: do not reopen afterwards
  --backup-keep N         after successful apply (or with --recycle-backups):
                          keep N newest backup stamps (default 1; 0=delete all)
  --recycle-backups       only apply backup retention; no history delete
  --per-domain-timeout S  ego only: seconds per domain process (default 180)
EOF
}

log() {
  local level="$1"; shift
  if declare -F "runtime_log_$level" >/dev/null 2>&1; then
    "runtime_log_$level" browser_agent "$@" || true
  fi
}

now_ms() {
  if declare -F runtime_log_now_ms >/dev/null 2>&1; then runtime_log_now_ms; else date +%s%3N; fi
}

# Load browsers.tsv → parallel arrays browser_ids / browser_udd_rel / browser_procs / browser_labels
browser_ids=() browser_udd_rel=() browser_procs=() browser_labels=()
load_browsers_tsv() {
  local line id udd procs label
  [[ -r "$BROWSERS_TSV" ]] || {
    printf 'browser-history-purge: cannot read browsers table %s\n' "$BROWSERS_TSV" >&2
    exit 2
  }
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    IFS=$'\t' read -r id udd procs label <<<"$line"
    [[ -n "$id" && -n "$udd" && -n "$procs" && -n "$label" ]] || continue
    browser_ids+=("$id")
    browser_udd_rel+=("$udd")
    browser_procs+=("$procs")
    browser_labels+=("$label")
  done < "$BROWSERS_TSV"
  [[ ${#browser_ids[@]} -gt 0 ]] || {
    printf 'browser-history-purge: browsers table %s has no entries\n' "$BROWSERS_TSV" >&2
    exit 2
  }
}

browser_lookup() {  # id → sets cur_id cur_udd_rel cur_procs cur_label; return 1 if unknown
  local want="$1" i
  for i in "${!browser_ids[@]}"; do
    if [[ "${browser_ids[$i]}" == "$want" ]]; then
      cur_id="${browser_ids[$i]}"
      cur_udd_rel="${browser_udd_rel[$i]}"
      cur_procs="${browser_procs[$i]}"
      cur_label="${browser_labels[$i]}"
      return 0
    fi
  done
  return 1
}

is_chromium_id() {
  local id="$1" x
  for x in "${browser_ids[@]}"; do [[ "$x" == "$id" ]] && return 0; done
  return 1
}

target="" apply=0 stop=0 restart=1 profile="" per_domain_timeout=180
backup_keep=1 recycle_backups=0
domain_args=() domain_files=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target) target="${2-}"; shift 2 ;;
    --target=*) target="${1#*=}"; shift ;;
    --domains) domain_args+=("${2-}"); shift 2 ;;
    --domains=*) domain_args+=("${1#*=}"); shift ;;
    --domains-file) domain_files+=("${2-}"); shift 2 ;;
    --domains-file=*) domain_files+=("${1#*=}"); shift ;;
    --apply) apply=1; shift ;;
    --stop) stop=1; shift ;;
    --no-restart) restart=0; shift ;;
    --profile) profile="${2-}"; shift 2 ;;
    --profile=*) profile="${1#*=}"; shift ;;
    --backup-keep) backup_keep="${2-}"; shift 2 ;;
    --backup-keep=*) backup_keep="${1#*=}"; shift ;;
    --recycle-backups) recycle_backups=1; shift ;;
    --per-domain-timeout) per_domain_timeout="${2-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'browser-history-purge: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

load_browsers_tsv

case "$target" in
  ego|chromium|chrome-debug) ;;
  "") printf 'browser-history-purge: --target chrome|edge|brave|chromium|chrome-debug|ego is required\n' >&2; exit 2 ;;
  *)
    if ! is_chromium_id "$target"; then
      printf 'browser-history-purge: --target must be chrome|edge|brave|chromium|chrome-debug|ego (got %s)\n' "$target" >&2
      exit 2
    fi
    ;;
esac

if [[ ! "$backup_keep" =~ ^[0-9]+$ ]]; then
  printf 'browser-history-purge: --backup-keep must be a non-negative integer\n' >&2; exit 2
fi

if [[ "$recycle_backups" -eq 1 ]]; then
  if [[ "$target" == ego || "$target" == chromium ]]; then
    printf 'browser-history-purge: --recycle-backups needs chrome|edge|brave|chrome-debug\n' >&2; exit 2
  fi
  if [[ "$apply" -eq 1 || "$stop" -eq 1 ]]; then
    printf 'browser-history-purge: --recycle-backups cannot combine with --apply/--stop\n' >&2; exit 2
  fi
fi

if [[ "$stop" -eq 1 && ( "$apply" -ne 1 || "$target" == ego ) ]]; then
  printf 'browser-history-purge: --stop only works with a chromium-family --target and --apply\n' >&2; exit 2
fi
if [[ "$restart" -eq 0 && "$stop" -ne 1 ]]; then
  printf 'browser-history-purge: --no-restart only makes sense with --stop\n' >&2; exit 2
fi
if [[ -n "$profile" && "$target" == chromium ]]; then
  printf 'browser-history-purge: --profile cannot be used with --target chromium\n' >&2; exit 2
fi
if [[ -n "$profile" && "$target" == ego ]]; then
  printf 'browser-history-purge: --profile is only for chrome|edge|brave|chrome-debug\n' >&2; exit 2
fi

# Collect + validate hostnames (shared by purge targets; skipped for recycle-only).
domains=()
add_domain() {
  local d
  d="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  [[ -z "$d" ]] && return 0
  if [[ ! "$d" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; then
    printf 'browser-history-purge: not a hostname: %s\n' "$d" >&2
    exit 2
  fi
  local x
  for x in "${domains[@]}"; do [[ "$x" == "$d" ]] && return 0; done
  domains+=("$d")
}
for arg in "${domain_args[@]}"; do
  IFS=',' read -r -a parts <<< "$arg"
  for p in "${parts[@]}"; do add_domain "$p"; done
done
for f in "${domain_files[@]}"; do
  [[ -r "$f" ]] || { printf 'browser-history-purge: cannot read %s\n' "$f" >&2; exit 2; }
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    add_domain "$line"
  done < "$f"
done
if [[ "$recycle_backups" -eq 0 && ${#domains[@]} -eq 0 ]]; then
  printf 'browser-history-purge: no domains; pass --domains or --domains-file\n' >&2
  exit 2
fi

mode=dry-run
[[ "$apply" -eq 1 ]] && mode=apply
[[ "$recycle_backups" -eq 1 ]] && mode=recycle-backups
started_ms="$(now_ms)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# ── Windows helpers ──────────────────────────────────────────────────
# All Windows calls go through windows-shell-lib; tests inject
# BROWSER_HISTORY_PURGE_POWERSHELL (a script taking the PowerShell command).
ps_run() {
  if [[ -n "${BROWSER_HISTORY_PURGE_POWERSHELL:-}" ]]; then
    "$BROWSER_HISTORY_PURGE_POWERSHELL" "$1"
    return
  fi
  # shellcheck disable=SC1091
  declare -F windows_run_powershell_command_utf8 >/dev/null || source "$RUNTIME_DIR/windows-shell-lib.sh"
  windows_run_powershell_command_utf8 "$1"
}

# Writes `PID<TAB>CommandLine` for the given exe names (comma-separated) to $1.
enum_browser_procs() {
  local out="$1" names_csv="$2"
  if [[ -n "${BROWSER_HISTORY_PURGE_CMDLINES_FILE:-}" ]]; then
    cp "$BROWSER_HISTORY_PURGE_CMDLINES_FILE" "$out"
    return
  fi
  local ps_names="" n
  IFS=',' read -r -a _names <<< "$names_csv"
  for n in "${_names[@]}"; do
    n="${n// /}"
    [[ -z "$n" ]] && continue
    [[ -n "$ps_names" ]] && ps_names+=", "
    ps_names+="'$n'"
  done
  # Keep "Get-CimInstance" as the command prefix so test stubs can match it.
  ps_run "Get-CimInstance Win32_Process | Where-Object { @($ps_names) -contains \$_.Name } | ForEach-Object { \"{0}\`t{1}\" -f \$_.ProcessId, \$_.CommandLine }" \
    2>/dev/null | tr -d '\r' > "$out"
  [[ "${PIPESTATUS[0]}" -eq 0 ]]
}

# Prints holders of the target profile (PID role exe udd); non-zero when enumeration failed.
# Uses globals: profile default_user_data cur_procs
browser_holders() {
  enum_browser_procs "$tmp/holders-cmdlines.txt" "$cur_procs" || return 1
  local occ_args=(--print-occupying --profile "$profile" --process-names "$cur_procs"
                  --process-cmdlines-file "$tmp/holders-cmdlines.txt")
  # chrome-debug must not treat flagless chrome.exe as a holder.
  if [[ "$cur_id" != chrome-debug && -n "${default_user_data:-}" ]]; then
    occ_args+=(--default-user-data "$default_user_data")
  fi
  python3 -I "$IMPL_DIR/chrome_purge.py" "${occ_args[@]}"
}

wait_no_holders() {
  local secs="$1" i out
  for ((i = 0; i < secs; i++)); do
    sleep "${BROWSER_HISTORY_PURGE_POLL_SECONDS:-1}"
    out="$(browser_holders)" || continue
    [[ -z "$out" ]] && return 0
  done
  return 1
}

taskkill_pids() {  # [/F] pid...
  local cmd="taskkill.exe" a
  for a in "$@"; do
    if [[ "$a" == /F ]]; then cmd+=" /F"; else cmd+=" /PID $a"; fi
  done
  ps_run "$cmd" >/dev/null 2>&1 || true
}

# Sets stopped_count / restart_exe / restart_udd / forced. Returns 3 on failure.
stopped_count=0 restart_exe="" restart_udd="" forced=0
stop_browser() {
  local holders
  if ! holders="$(browser_holders)"; then
    printf 'browser-history-purge: 无法枚举 %s 进程，--stop 不执行\n' "$cur_label" >&2
    return 3
  fi
  [[ -z "$holders" ]] && return 0
  stopped_count="$(printf '%s\n' "$holders" | wc -l)"
  local mains=() pid role exe udd
  while IFS=$'\t' read -r pid role exe udd; do
    if [[ "$role" == main ]]; then
      mains+=("$pid")
      [[ -n "$restart_exe" ]] || { restart_exe="$exe"; restart_udd="$udd"; }
    fi
  done <<<"$holders"
  [[ ${#mains[@]} -gt 0 ]] || mains=($(cut -f1 <<<"$holders"))
  local wait="${BROWSER_HISTORY_PURGE_STOP_WAIT:-20}"
  printf '正在关闭占用该 profile 的 %s（%d 个进程，主进程 %s），最多等 %ss…\n' \
    "$cur_label" "$stopped_count" "${mains[*]}" "$wait"
  taskkill_pids "${mains[@]}"
  if ! wait_no_holders "$wait"; then
    holders="$(browser_holders)" || holders=""
    if [[ -n "$holders" ]]; then
      forced="$(printf '%s\n' "$holders" | wc -l)"
      printf '%ss 内未全部退出，强制结束剩余 %d 个进程\n' "$wait" "$forced"
      taskkill_pids /F $(cut -f1 <<<"$holders")
    fi
    if ! wait_no_holders "${BROWSER_HISTORY_PURGE_FORCE_WAIT:-10}"; then
      printf 'browser-history-purge: %s 进程仍未退出，未做任何改动\n' "$cur_label" >&2
      return 3
    fi
  fi
  local i
  for ((i = 0; i < ${BROWSER_HISTORY_PURGE_LOCK_WAIT:-5}; i++)); do
    [[ -e "$(dirname "$profile")/lockfile" ]] || break
    sleep "${BROWSER_HISTORY_PURGE_POLL_SECONDS:-1}"
  done
  return 0
}

restarted=0
start_browser() {
  local exe="${restart_exe:-${cur_procs%%,*}}" args="'--restore-last-session'" q="'"
  [[ -n "$restart_udd" ]] && args+=",'--user-data-dir=${restart_udd//$q/$q$q}'"
  if ps_run "Start-Process -FilePath '${exe//$q/$q$q}' -ArgumentList $args" >/dev/null 2>&1; then
    restarted=1
    printf '已重新打开 %s（--restore-last-session 恢复原标签页）\n' "$cur_label"
  else
    printf 'browser-history-purge: 重新打开 %s 失败，请手动启动\n' "$cur_label" >&2
  fi
}

resolve_localappdata() {
  if [[ -n "${BROWSER_HISTORY_PURGE_LOCALAPPDATA:-}" ]]; then
    printf '%s' "$BROWSER_HISTORY_PURGE_LOCALAPPDATA"
    return 0
  fi
  # shellcheck disable=SC1091
  source "$RUNTIME_DIR/windows-runtime-paths-lib.sh"
  if ! windows_runtime_detect_paths || [[ -z "${WINDOWS_LOCALAPPDATA_WSL:-}" ]]; then
    printf 'browser-history-purge: cannot resolve Windows LOCALAPPDATA (windows_runtime_detect_paths)\n' >&2
    return 2
  fi
  printf '%s' "$WINDOWS_LOCALAPPDATA_WSL"
}

# Windows path or already-WSL path → WSL path for the debug Chrome user_data_dir.
resolve_chrome_debug_user_data() {
  local raw="" win=""
  if [[ -n "${BROWSER_HISTORY_PURGE_CHROME_DEBUG_USER_DATA:-}" ]]; then
    raw="$BROWSER_HISTORY_PURGE_CHROME_DEBUG_USER_DATA"
  else
    local constants="${WEZDECK_REPO:-$(cd "$RUNTIME_DIR/../.." && pwd)}/wezterm-x/local/constants.lua"
    [[ -f "$constants" ]] || {
      printf 'browser-history-purge: missing %s (set BROWSER_HISTORY_PURGE_CHROME_DEBUG_USER_DATA)\n' "$constants" >&2
      return 2
    }
    raw="$(perl -0ne '
      if (/chrome_debug_browser\s*=\s*\{.*?user_data_dir\s*=\s*'\''([^'\'']+)'\''/s) {
        my $value = $1;
        $value =~ s/\\\\/\\/g;
        print $value;
      }
    ' "$constants")"
    [[ -n "$raw" ]] || {
      printf 'browser-history-purge: chrome_debug_browser.user_data_dir not set in constants.lua\n' >&2
      return 2
    }
  fi
  if [[ "$raw" == /mnt/* || "$raw" == /* ]]; then
    printf '%s' "$raw"
    return 0
  fi
  # E:\chrome-profiles\ai or E:/...
  if command -v wslpath >/dev/null 2>&1; then
    wslpath -u "$raw"
    return
  fi
  win="${raw//\\//}"
  if [[ "$win" =~ ^([A-Za-z]):/(.*)$ ]]; then
    printf '/mnt/%s/%s' "${BASH_REMATCH[1],,}" "${BASH_REMATCH[2]}"
    return 0
  fi
  printf 'browser-history-purge: cannot convert user_data_dir to WSL path: %s\n' "$raw" >&2
  return 2
}

setup_chrome_debug_cur() {
  cur_id="chrome-debug"
  cur_procs="chrome.exe"
  cur_label="调试 Chrome"
  cur_udd_rel=""  # unused; absolute path via CHROME_DEBUG_UDD
  local udd
  udd="$(resolve_chrome_debug_user_data)" || return $?
  BROWSER_HISTORY_PURGE_CHROME_DEBUG_UDD="$udd"
  export BROWSER_HISTORY_PURGE_CHROME_DEBUG_UDD
}

# Run one chromium-family browser. Uses / sets: cur_* profile default_user_data
# Writes result to $1 (result json path). Returns status code.
run_one_chromium() {
  local result_json="$1"
  local localappdata status=0 occupy_default=""
  stopped_count=0 restart_exe="" restart_udd="" forced=0 restarted=0

  if [[ "$cur_id" == chrome-debug ]]; then
    default_user_data="${BROWSER_HISTORY_PURGE_CHROME_DEBUG_UDD:?}"
    # Empty occupy_default: only explicit --user-data-dir matches debug profile.
    occupy_default=""
  elif [[ -n "${BROWSER_HISTORY_PURGE_DEFAULT_USER_DATA:-}" && "$target" != chromium ]]; then
    # Test / override hook for a single-browser run (existing chrome tests).
    default_user_data="$BROWSER_HISTORY_PURGE_DEFAULT_USER_DATA"
    occupy_default="$default_user_data"
  else
    localappdata="$(resolve_localappdata)" || return 2
    default_user_data="$localappdata/$cur_udd_rel"
    occupy_default="$default_user_data"
  fi
  # Per-browser override for chromium multi-run tests.
  if [[ -n "${BROWSER_HISTORY_PURGE_USER_DATA_PREFIX:-}" && "$cur_id" != chrome-debug ]]; then
    default_user_data="$BROWSER_HISTORY_PURGE_USER_DATA_PREFIX/$cur_id/User Data"
    occupy_default="$default_user_data"
  fi

  local this_profile="$profile"
  [[ -n "$this_profile" ]] || this_profile="$default_user_data/Default"
  profile="$this_profile"

  if [[ ! -f "$profile/History" ]]; then
    printf '%s: 未安装或无 History（%s），跳过\n' "$cur_label" "$profile"
    printf '{"target":"%s","mode":"%s","ok":true,"skipped":"not-installed","urls":0,"visits":0,"shortcuts":0,"top_sites":0}\n' \
      "$cur_id" "$mode" > "$result_json"
    return 0
  fi

  printf '── %s (%s) ──\n' "$cur_label" "$cur_id"

  if [[ "$recycle_backups" -eq 1 ]]; then
    python3 -I "$IMPL_DIR/chrome_purge.py" --profile "$profile" --recycle-backups \
      --backup-keep "$backup_keep" --browser-id "$cur_id" --result-json "$result_json" || status=$?
    return "$status"
  fi

  local py_args=(--profile "$profile" --browser-id "$cur_id" --label "$cur_label"
                 --process-names "$cur_procs" --backup-keep "$backup_keep"
                 --result-json "$result_json")
  [[ -n "$occupy_default" ]] && py_args+=(--default-user-data "$occupy_default")
  local joined
  joined="$(IFS=,; printf '%s' "${domains[*]}")"
  py_args+=(--domains "$joined")

  if [[ "$apply" -eq 1 ]]; then
    py_args+=(--apply)
    if [[ "$stop" -eq 1 ]]; then
      local st=0
      stop_browser || st=$?
      if [[ "$st" -ne 0 ]]; then
        printf '{"target":"%s","mode":"apply","ok":false,"refused":"stop-failed"}\n' "$cur_id" > "$result_json"
        return "$st"
      fi
    fi
    local cmdlines="$tmp/procs-$cur_id.txt"
    enum_browser_procs "$cmdlines" "$cur_procs" && py_args+=(--process-cmdlines-file "$cmdlines")
  fi

  python3 -I "$IMPL_DIR/chrome_purge.py" "${py_args[@]}" || status=$?
  # chrome-debug: prefer helper auto-start; Start-Process would drop --headless flags.
  if [[ "$cur_id" == chrome-debug ]]; then
    [[ "$stopped_count" -gt 0 && "$restart" -eq 1 ]] && \
      printf '调试 Chrome 已关闭；未自动拉起（用 Alt+b / helper 恢复 headless）。加显式重启需求时再改。\n'
  else
    [[ "$stopped_count" -gt 0 && "$restart" -eq 1 ]] && start_browser
  fi
  return "$status"
}

sum_field() {
  python3 -I - "$1" "$2" <<'PY'
import json, sys
rows = json.load(open(sys.argv[1], encoding="utf-8"))
key = sys.argv[2]
print(sum(int(r.get(key) or 0) for r in rows if not r.get("skipped")))
PY
}

run_chromium_targets() {
  local ids=("$@")
  local id status=0 worst=0 results=()
  local total_stopped=0 total_forced=0 total_restarted=0
  : > "$tmp/chromium-results.jsonl"
  for id in "${ids[@]}"; do
    if [[ "$id" == chrome-debug ]]; then
      setup_chrome_debug_cur || {
        printf '{"target":"chrome-debug","ok":false,"refused":"no-user-data-dir"}\n' > "$tmp/result-$id.json"
        status=2
        [[ "$status" -gt "$worst" ]] && worst="$status"
        cat "$tmp/result-$id.json" >> "$tmp/chromium-results.jsonl"
        printf '\n' >> "$tmp/chromium-results.jsonl"
        continue
      }
    else
      browser_lookup "$id" || continue
    fi
    profile=""  # each leg uses its own Default unless single-target set profile before call
    # For single-target callers that already set profile, keep it only for that id.
    if [[ "$target" != chromium && -n "${_single_profile:-}" ]]; then
      profile="$_single_profile"
    fi
    local rj="$tmp/result-$id.json"
    status=0
    run_one_chromium "$rj" || status=$?
    [[ -s "$rj" ]] || printf '{"target":"%s","ok":false,"refused":"no-result"}\n' "$id" > "$rj"
    # Attach stop metrics for logging aggregation
    python3 -I - "$rj" "$stopped_count" "$forced" "$restarted" <<'PY'
import json, sys
p, stopped, forced, restarted = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
r = json.load(open(p, encoding="utf-8"))
r["stopped"] = stopped
r["forced"] = forced
r["restarted"] = restarted
json.dump(r, open(p, "w", encoding="utf-8"), ensure_ascii=False)
PY
    cat "$rj" >> "$tmp/chromium-results.jsonl"
    printf '\n' >> "$tmp/chromium-results.jsonl"
    total_stopped=$((total_stopped + stopped_count))
    total_forced=$((total_forced + forced))
    total_restarted=$((total_restarted + restarted))
    if [[ "$status" -ne 0 ]]; then
      printf '%s: 失败（exit %s），继续其它浏览器\n' "$cur_label" "$status" >&2
      [[ "$status" -gt "$worst" ]] && worst="$status"
    fi
  done
  stopped_count="$total_stopped"
  forced="$total_forced"
  restarted="$total_restarted"

  python3 -I - "$tmp/chromium-results.jsonl" "$tmp/result.json" "$mode" "$target" <<'PY'
import json, sys
rows = [json.loads(l) for l in open(sys.argv[1], encoding="utf-8") if l.strip()]
mode, target = sys.argv[3], sys.argv[4]
active = [r for r in rows if not r.get("skipped")]
skipped = [r["target"] for r in rows if r.get("skipped")]
failed = [r["target"] for r in active if not r.get("ok", False)]
res = {
    "target": target,
    "mode": mode,
    "browsers": [r["target"] for r in rows],
    "skipped": skipped,
    "failed": failed,
    "urls": sum(int(r.get("urls") or 0) for r in active),
    "visits": sum(int(r.get("visits") or 0) for r in active),
    "shortcuts": sum(int(r.get("shortcuts") or 0) for r in active),
    "top_sites": sum(int(r.get("top_sites") or 0) for r in active),
    "ok": not failed,
}
refused = [r["refused"] for r in active if r.get("refused")]
if len(refused) == 1:
    res["refused"] = refused[0]
elif refused:
    res["refused"] = ",".join(refused)
# Single-browser runs keep a flat result (compat with existing logs/tests).
if target != "chromium" and len(rows) == 1:
    flat = dict(rows[0])
    flat["target"] = target
    for k in ("urls", "visits", "shortcuts", "top_sites", "ok", "refused", "mode"):
        if k in res and k not in flat:
            flat[k] = res[k]
        elif k in res:
            flat[k] = res[k]
    res = flat
else:
    res["per_browser"] = rows
json.dump(res, open(sys.argv[2], "w", encoding="utf-8"), ensure_ascii=False)
if target == "chromium":
    n = res.get("urls", 0)
    verb = "已删除" if mode == "apply" else "将删除（dry-run）"
    parts = []
    if skipped:
        parts.append("跳过 " + ",".join(skipped))
    if failed:
        parts.append("失败 " + ",".join(failed))
    extra = ("；" + "；".join(parts)) if parts else ""
    print(
        f"chromium 汇总：历史网址 {n} 条 / 访问 {res.get('visits', 0)} / "
        f"快捷建议 {res.get('shortcuts', 0)} / 常用网站 {res.get('top_sites', 0)}"
        f"（{verb}）{extra}"
    )
PY
  return "$worst"
}

# ── ego ──────────────────────────────────────────────────────────────
run_ego() {
  local ego="${BROWSER_HISTORY_PURGE_EGO_BROWSER:-$SCRIPT_DIR/ego-browser}"
  local tmpl="$IMPL_DIR/ego-history-delete.tmpl.mjs"
  local d script out rc line failed=0 total_found=0 total_deleted=0 total_remaining=0
  : > "$tmp/ego-results.jsonl"
  for d in "${domains[@]}"; do
    # Hostname is validated above, so it is safe as a bare JSON string.
    script="$(sed -e "s/__DOMAIN__/\"$d\"/" -e "s/__MODE__/\"$mode\"/" "$tmpl")"
    rc=0
    out="$(timeout --kill-after=10 "$per_domain_timeout" "$ego" nodejs -e "$script" 2>&1)" || rc=$?
    line="$(printf '%s\n' "$out" | grep -o 'BHP_RESULT {.*}' | tail -n1 | sed 's/^BHP_RESULT //')"
    if [[ -z "$line" ]]; then
      local why="no-result"
      [[ "$rc" -eq 124 || "$rc" -eq 137 ]] && why="timeout-${per_domain_timeout}s"
      line="$(printf '{"domain":"%s","mode":"%s","error":"%s","exit":%d}' "$d" "$mode" "$why" "$rc")"
      printf '%s\n' "$out" | tail -n 5 >&2
    fi
    printf '%s\n' "$line" >> "$tmp/ego-results.jsonl"
    python3 -I - "$line" <<'PY'
import json, sys
r = json.loads(sys.argv[1])
d = r["domain"]
if r.get("error"):
    print(f"  {d}: 失败 {r['error']}（已删 {r.get('deleted', 0)}）")
elif r.get("mode") == "apply":
    print(f"  {d}: 删除 {r.get('deleted', 0)} 条，回读剩余 {r.get('remaining')}")
else:
    print(f"  {d}: 首屏命中 {r.get('found', 0)} 条（dry-run）")
PY
  done
  python3 -I - "$tmp/ego-results.jsonl" "$tmp/result.json" "$mode" <<'PY'
import json, sys
rows = [json.loads(l) for l in open(sys.argv[1], encoding="utf-8") if l.strip()]
mode = sys.argv[3]
bad = [r["domain"] for r in rows if r.get("error") or (mode == "apply" and r.get("remaining") != 0)]
res = {
    "target": "ego", "mode": mode, "domains": len(rows),
    "found": sum(r.get("found", 0) for r in rows),
    "deleted": sum(r.get("deleted", 0) for r in rows),
    "remaining": sum(r.get("remaining") or 0 for r in rows),
    "failed_domains": bad, "ok": not bad,
}
json.dump(res, open(sys.argv[2], "w", encoding="utf-8"))
verb = "已删除" if mode == "apply" else "首屏命中（dry-run，加 --apply 执行）"
n = res["deleted"] if mode == "apply" else res["found"]
print(f"ego {verb}：{n} 条；失败域名 {len(bad)} 个" + (f"：{','.join(bad)}" if bad else ""))
PY
  python3 -I -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1]))["ok"] else 1)' "$tmp/result.json"
}

status=0
case "$target" in
  ego) run_ego || status=$? ;;
  chromium)
    run_chromium_targets "${browser_ids[@]}" || status=$?
    ;;
  chrome-debug)
    _single_profile="$profile"
    run_chromium_targets chrome-debug || status=$?
    ;;
  *)
    browser_lookup "$target"
    _single_profile="$profile"
    run_chromium_targets "$target" || status=$?
    ;;
esac

duration_ms="$(( $(now_ms) - started_ms ))"
fields=(target="$target" mode="$mode" domains="${#domains[@]}" status="$status" duration_ms="$duration_ms")
[[ "$stop" -eq 1 ]] && fields+=(stopped="$stopped_count" forced="$forced" restarted="$restarted")
[[ "$recycle_backups" -eq 1 || "$apply" -eq 1 ]] && fields+=(backup_keep="$backup_keep")
if [[ -s "$tmp/result.json" ]]; then
  while IFS= read -r kv; do fields+=("$kv"); done < <(
    python3 -I - "$tmp/result.json" <<'PY'
import json, sys
r = json.load(open(sys.argv[1], encoding="utf-8"))
for k in ("urls", "visits", "shortcuts", "top_sites", "found", "deleted", "remaining",
          "refused", "ok", "skipped", "recycled", "backup_stamp"):
    if k in r:
        v = r[k]
        if isinstance(v, list):
            print(f"{k}={','.join(str(x) for x in v)}")
        else:
            print(f"{k}={json.dumps(v) if isinstance(v, bool) else v}")
if r.get("browsers"):
    print("browsers=" + ",".join(r["browsers"]))
if r.get("failed"):
    print("failed=" + ",".join(r["failed"]))
if isinstance(r.get("kept"), list):
    print("kept=" + ",".join(r["kept"]))
br = r.get("backup_recycle") or {}
if br.get("kept") is not None:
    print("backup_kept=" + ",".join(br["kept"]))
if "recycled" in br:
    print(f"backup_recycled={br['recycled']}")
PY
  )
fi
if [[ "$status" -eq 0 ]]; then
  log info "browser-history-purge completed" "${fields[@]}"
else
  log warn "browser-history-purge failed" "${fields[@]}"
fi
exit "$status"

#!/usr/bin/env bash
# claude-sub2api — one-shot Claude Code on the sub2api gateway profile.
#
# Thin wrapper around agent-launcher.sh so interactive shells can start the
# same identity wezdeck managed panes use when
# MANAGED_AGENT_PROFILE=claude_sub2api. Credentials:
#   ~/.config/claude-profiles/sub2api.env  (or $CLAUDE_SUB2API_ENV)
# Docs: docs/setup.md#claude-auth-profiles

set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
runtime_dir="$(cd "$script_dir/.." && pwd -P)"
launcher="$runtime_dir/agent-launcher.sh"

if [[ ! -f "$launcher" ]]; then
  printf 'claude-sub2api: agent-launcher.sh not found at %s\n' "$launcher" >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  exec bash "$launcher" claude-sub2api
fi

# One-shot with user argv: same env + isolated home as the launcher.
# shellcheck disable=SC1091
. "$runtime_dir/runtime-env-lib.sh"
runtime_env_load_managed
# shellcheck disable=SC1091
. "$runtime_dir/agent-claude-sub2api-lib.sh"
load_claude_sub2api_env
exec claude "$@"

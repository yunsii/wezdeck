#!/usr/bin/env bash
# x — human short path for wd-run handoff: peek latest → confirm → CAS run.
# Not related to Alt+x (overflow picker). Override name via WD_RUN_HUMAN_CMD.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WD_RUN="$SCRIPT_DIR/wd-run"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../agent-run-lib.sh"

usage() {
  cat <<'EOF' >&2
usage:
  x           peek HEAD, then Enter=run / other=cancel for the id you viewed
  x -         peek only (no confirm)
  x --id ID   CAS-run id without pager (still requires id == HEAD unless
              you use wd-run run --id ID --force-id)

Only consumes human-handoff entries created by: wd-run propose --cwd …
EOF
}

peek_only=0
run_id=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -)
      peek_only=1
      shift
      ;;
    --id)
      run_id="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'x: unknown arg %s\n' "$1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -n "$run_id" ]]; then
  exec "$WD_RUN" run --id "$run_id"
fi

agent_run_ensure_dirs
bound_id="$(agent_run_read_head_id)" || {
  printf 'x: 当前没有待执行的人工脚本（HEAD 空）。\n' >&2
  printf 'x: 若 agent 刚说「正在准备」，等会话出现「脚本已就绪」后再跑 x。\n' >&2
  exit "$AGENT_RUN_EXIT_MISSING"
}

"$WD_RUN" peek --id "$bound_id"

if [[ "$peek_only" -eq 1 ]]; then
  exit 0
fi

bound_summary=""
bound_path="$(agent_run_entry_path "$bound_id")"
if [[ -s "$bound_path" ]] && command -v jq >/dev/null 2>&1; then
  bound_summary="$(jq -r '.summary // empty' "$bound_path" 2>/dev/null || true)"
fi

if [[ ! -t 0 ]]; then
  printf 'x: non-interactive stdin; peeked id=%s — run with: x --id %s\n' \
    "$bound_id" "$bound_id" >&2
  exit 0
fi

if [[ -n "$bound_summary" ]]; then
  printf 'Run id=%s 「%s」 in recorded cwd? [Enter=run / other=cancel] ' \
    "$bound_id" "$bound_summary" >&2
else
  printf 'Run id=%s in recorded cwd? [Enter=run / other=cancel] ' "$bound_id" >&2
fi
read -r ans || ans=""
if [[ -z "$ans" ]]; then
  # Empty Enter confirms. CAS against the id bound at peek time —
  # never silently run a newer HEAD.
  exec "$WD_RUN" run --id "$bound_id"
fi
printf 'x: cancelled (HEAD may still be pending)\n' >&2
exit 0

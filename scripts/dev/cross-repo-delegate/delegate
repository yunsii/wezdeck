#!/usr/bin/env bash
# Thin PATH entry for the delegate runner.
# Prefer: scripts/dev/delegate/run.sh install-cli  →  ~/.local/bin/delegate
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
exec "$root/run.sh" "$@"

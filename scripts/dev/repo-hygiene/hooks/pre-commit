#!/usr/bin/env bash
# Installed into the shared git hooks directory. Resolves the current
# worktree / checkout and runs that tree's repo-hygiene pre-commit gate.
set -euo pipefail

if [[ "${WEZTERM_HYGIENE_SKIP:-}" == "1" ]]; then
  echo "[repo-hygiene] WEZTERM_HYGIENE_SKIP=1 — bypassing (emergency only)" >&2
  exit 0
fi

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
runner="$root/scripts/dev/repo-hygiene/run.sh"
if [[ ! -x "$runner" ]]; then
  echo "[repo-hygiene] runner missing at $runner — skip" >&2
  exit 0
fi

extra=()
if [[ "${WEZTERM_HYGIENE_SOFT_ANCHORS:-}" == "1" ]]; then
  extra+=(--soft-anchors)
fi

exec "$runner" pre-commit "${extra[@]}"
